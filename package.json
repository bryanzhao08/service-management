    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "sharp": "^0.35.4",
    "svix": "^2.5.0",
