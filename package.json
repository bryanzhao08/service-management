    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
