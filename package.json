{
  "name": "transient",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contrast": "node scripts/contrast.mjs",
    "contrast:check": "node scripts/contrast.mjs --check",
    "check:ui": "node scripts/check-ui.mjs",
    "db:up": "docker compose up -d postgres minio minio-init",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:test:setup": "bash scripts/db-test-setup.sh",
    "db:studio": "prisma studio",
    "jobs:sweep": "tsx scripts/sweep.ts",
    "gen:vapid": "tsx scripts/gen-vapid.ts",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "check:auth": "node scripts/check-auth.mjs",
    "check:landing": "node scripts/check-landing.mjs",
    "check:shift": "node scripts/check-shift.mjs",
    "check:jobs": "node scripts/check-jobs.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm contrast:check && pnpm test",
    "check:report": "node scripts/check-report.mjs"
  },
