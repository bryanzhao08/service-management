# ==============================================================================
# Transient — environment
# ==============================================================================
# Copy to `.env` and fill in. Every variable below is read somewhere in the app;
# the ones marked OPTIONAL have a working local fallback, which is what lets
# `pnpm dev` run with no third-party account (section 23).
# ==============================================================================

# --- Database -----------------------------------------------------------------
# Matches docker-compose.yml. `pnpm db:up` starts it.
DATABASE_URL="postgresql://transient:transient@localhost:5544/transient?schema=public"

# The `db` vitest project runs against this one, and it TRUNCATES EVERY TABLE
# between tests. `pnpm db:test:setup` creates and migrates it, and both that
# script and tests/db/helpers.ts refuse to run unless the name contains "test".
DATABASE_URL_TEST="postgresql://transient@127.0.0.1:5544/transient_test?schema=public"

# --- Auth.js (NextAuth v5) ----------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sign-in links are built from AUTH_URL / NEXT_PUBLIC_APP_URL, NOT from the port
# the server actually binds. Run on a different port without changing these and
# every magic link will point at :3000 and fail quietly.

# OPTIONAL. Set to exactly "1" to add email + PIN sign-in alongside the magic
# link, which is how someone re-enters quickly on a shared phone. Off by default
# because it is a weaker factor than a one-time link; see src/lib/auth/pin-sign-in.ts.
# PIN_SIGN_IN_ENABLED="1"

# --- Email --------------------------------------------------------------------
# OPTIONAL. With RESEND_API_KEY absent the app uses ConsoleEmailProvider, which
# writes rendered messages to ./.data/outbox/*.html and simulates a `delivered`
# webhook after 3s so the golden path works offline. Set the key to send real
# mail through Resend.
# RESEND_API_KEY="re_..."
# RESEND_WEBHOOK_SECRET="whsec_..."
EMAIL_FROM="Transient <reports@transient.local>"

# --- Object storage -----------------------------------------------------------
# STORAGE_DRIVER=local writes to ./.data/uploads and needs nothing else.
# STORAGE_DRIVER=s3 works against Neon Object Storage (what the deploy uses),
# Cloudflare R2, AWS S3, or the MinIO in docker-compose.yml (endpoint
# http://localhost:9000, key/secret below).
STORAGE_DRIVER="local"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="transient"
# S3_ACCESS_KEY_ID="transient"
# S3_SECRET_ACCESS_KEY="transient123"
# S3_FORCE_PATH_STYLE="true"
#
# Neon Object Storage: declare the bucket in neon.ts, run `neon config apply`,
# then copy the AWS_* values it writes into .env across to the S3_* names above.
# The endpoint is branch-scoped: https://<branch-id>.storage.<region>.aws.neon.tech
#
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region
# the literal "auto", path style true, and long-lived keys from an R2 API token.
#
# Only for temporary credentials (AWS STS or an assumed IAM role). Leave unset
# for long-lived keys such as Neon, R2, or MinIO.
# S3_SESSION_TOKEN=""

# --- Signed links -------------------------------------------------------------
# Signs the /r/[token] report gallery and receipt links.
# Generate with: openssl rand -base64 32
LINK_SIGNING_SECRET="replace-me-openssl-rand-base64-32"

# --- Web Push -----------------------------------------------------------------
# OPTIONAL. Generate a pair with: pnpm gen:vapid
# Push is skipped (and logged) when these are absent.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@transient.local"
# The public key is also needed in the browser to subscribe.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Cron ---------------------------------------------------------------------
# GET /api/jobs/sweep requires this in an `Authorization: Bearer` header.
CRON_SECRET="replace-me-any-random-string"

# --- Native device testing ---------------------------------------------------
# Export these when running mobile:sync; Capacitor does not read this .env file.
# Hosted Next.js runs on the server, and the test apps open its dashboard.
# MOBILE_APP_URL="https://your-project.vercel.app"
# HTTP is disabled unless explicitly enabled for a local LAN/emulator build.
# MOBILE_ALLOW_HTTP="1"
# Add an app sign-in link alongside the browser link in magic-link emails.
# MOBILE_EMAIL_LINKS="1"
